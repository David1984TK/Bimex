STELLAR_RPC_URL=https://mainnet.stellar.validationcloud.io/v1/<KEY>
CONTRACT_ID=<MAINNET_CONTRACT_ID>
SUPABASE_URL=<supabase_project_url>
SUPABASE_KEY=<supabase_anon_key>
# Ledger sequence to start indexing from (0 = latest)
START_LEDGER=0
# Polling interval in milliseconds
POLL_INTERVAL_MS=10000
# Analytics API port
API_PORT=3002
# Health check port
HEALTH_PORT=3001
# Allowed origins for CORS (comma-separated, no spaces).
# Only these origins can call the API from a browser.
# Defaults: https://bimex.vercel.app, https://bimex.mx, localhost:5173 (dev)
ALLOWED_ORIGINS=https://bimex.vercel.app,https://bimex.mx

# IPFS / Pinata (server-side only — secret keys, never VITE_ prefixed)
# Get keys at https://app.pinata.cloud/keys
PINATA_API_KEY=
PINATA_SECRET=
# Rate limit for POST /ipfs-upload per IP (default 10/hour)
IPFS_UPLOAD_LIMIT=10

# Faucet (testnet only — secret key, never VITE_ prefixed)
FAUCET_SECRET=
TOKEN_MXNE=CDDIGHPVTW4PSCQCU67NQ4NXZ4NX5GDLNL3O67WT5RQ4GT6RXIEYPC4P

# Notifications (Resend)
RESEND_API_KEY=<resend_api_key>
RESEND_FROM=Bimex <notificaciones@bimex.fi>
# Base URL used to build links inside transactional emails (default: https://bimex.fi)
FRONTEND_URL=https://bimex.fi

# Monthly report job (optional overrides)
REPORTE_PERIODO=          # Override period YYYY-MM (auto = previous month)
REPORTE_CONCURRENCY=3     # Max parallel email sends
REPORTE_BATCH_SIZE=10     # Contributors per batch

# HTTP API & Payload Settings
MAX_BODY_BYTES=65536      # Max request body size in bytes (default: 64KB)
PUBLIC_CACHE_SECONDS=15   # Cache-Control max-age for public endpoints in seconds (default: 15)
YIELD_HISTORICO_MAX_EVENTOS=5000  # Max events to process in /yield/historico (default: 5000)

# Rate Limiter (distributed across instances or in-memory)
RATE_LIMIT_STORE=supabase # Backend store: 'supabase' (distributed) or 'memory' (default: supabase)
RATE_LIMIT_PUBLIC_MAX=60  # Max requests per window for public endpoints (default: 60)
RATE_LIMIT_PUBLIC_WINDOW_MS=60000  # Public rate limit window in ms (default: 60000 = 1 min)
RATE_LIMIT_FAUCET_MAX=3   # Max claims per window for testnet faucet (default: 3)
RATE_LIMIT_FAUCET_WINDOW_MS=3600000 # Faucet rate limit window in ms (default: 3600000 = 1 hour)
RATE_LIMIT_SSE_MAX_CONNECTIONS=5    # Max concurrent SSE connections allowed per client (default: 5)
RATE_LIMIT_SUPABASE_BACKOFF_MS=60000 # Supabase backoff duration on failure in ms (default: 60000)
RATE_LIMIT_SSE_SUPABASE_TTL_SECONDS=90 # TTL for SSE connection records in Supabase (default: 90)
RATE_LIMIT_SSE_SUPABASE_HEARTBEAT_MS=30000 # Heartbeat interval for SSE Supabase records (default: 30000)

# Server-Sent Events (SSE) limits & keepalive
SSE_MAX_PER_IP=5          # Max concurrent SSE connections per IP (default: 5)
SSE_MAX_TOTAL=500         # Max total concurrent SSE connections across all clients (default: 500)
SSE_HEARTBEAT_MS=30000    # SSE keepalive comment heartbeat interval in ms (default: 30000)

# Backups
BACKUP_DIR=./backups      # Directory where automated database backups are saved (default: ./backups)

