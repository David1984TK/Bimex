# Stellar / Soroban
VITE_CONTRACT_ID=
VITE_RPC_URL=https://soroban-testnet.stellar.org
VITE_TOKEN_MXNE=
VITE_MXNE_ISSUER=
VITE_HORIZON_URL=
VITE_ADMIN_ADDRESS=

# Passkey Wallet & Gasless
VITE_PASSKEY_WASM_HASH=
VITE_LAUNCHTUBE_URL=https://testnet.launchtube.xyz
VITE_LAUNCHTUBE_JWT=

# Stellar Wallets Kit & WalletConnect
# Get project ID at https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=c4f79cc821944d9680842e34466bfda0

# Indexer REST (faucet, transparencia, casos de éxito)
VITE_API_URL=http://localhost:3001

# Indexer (SSE, IPFS upload proxy)
VITE_INDEXER_URL=http://localhost:3001

# Same-origin /api proxy (hides the real indexer host from browser traffic):
# 1. Staging: already wired in vercel.json (bimex-staging.vercel.app → bimex-indexer-staging).
#    Use VITE_API_URL=/api and VITE_INDEXER_URL=/api (see .env.staging.example).
# 2. Production: add /api/:path* → https://<real-indexer-host>/:path* in vercel.json
#    (never commit placeholder hosts; PR #260 was closed for that), then set the same /api env vars.
# connect-src 'self' in CSP covers same-origin /api. SSE via Vercel proxy may hit connection duration limits.

# Supabase (for notification preferences)
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon_key>

# IPFS upload is handled server-side via the indexer proxy (/ipfs-upload).
# No client-side Pinata keys needed. Falls back to SHA-256 hash stored on-chain.

# Sentry (optional — for error tracking in production)
# Get DSN at https://sentry.io (free tier available)
# If not set, errors will only appear in browser console
VITE_SENTRY_DSN=

VITE_ETHERFUSE_RAMP_URL=
